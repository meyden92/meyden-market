#!/usr/bin/env python3
"""Live frame stats of a running three.js page.

  three-stats start     start the collector in the background and print the probe snippet
  three-stats latest    print the newest sample as JSON (exit 1 when no page is reporting)
  three-stats snippet   print the lines that attach the probe to a renderer
  three-stats stop      stop the collector
  three-stats serve     run the collector in the foreground

The collector listens on 127.0.0.1:47186 (THREE_STATS_PORT overrides), serves the probe at
/probe.js, and exits by itself after 30 minutes without a sample.
"""
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("THREE_STATS_PORT", "47186"))
BASE = "http://127.0.0.1:%d" % PORT
PROBE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts", "probe.js")
IDLE_SECONDS = 30 * 60
STALE_SECONDS = 5

SNIPPET = """// dev only: report frame stats to `three-stats`
if (import.meta.env?.DEV ?? true) {
  import(/* @vite-ignore */ "%s/probe.js").then((probe) => probe.attach(renderer)).catch(() => {});
}
// React Three Fiber: <Canvas onCreated={({ gl }) => { /* the lines above, with gl in place of renderer */ }}>""" % BASE

state = {"sample": None, "received": 0.0, "started": time.time()}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, status, body=b"", content_type="application/json"):
        self.send_response(status)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "content-type")
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.reply(204)

    def do_GET(self):
        if self.path.startswith("/probe.js"):
            with open(PROBE, "rb") as fh:
                self.reply(200, fh.read(), "text/javascript")
        elif self.path.startswith("/latest"):
            age = time.time() - state["received"]
            live = state["sample"] is not None and age < STALE_SECONDS
            body = {"live": live, "ageSeconds": round(age, 1) if state["sample"] else None, "sample": state["sample"]}
            self.reply(200, json.dumps(body).encode())
        elif self.path.startswith("/health"):
            self.reply(200, b'{"ok":true}')
        elif self.path.startswith("/stop"):
            self.reply(200, b'{"ok":true}')
            os._exit(0)
        else:
            self.reply(404, b"{}")

    def do_POST(self):
        if not self.path.startswith("/stats"):
            return self.reply(404, b"{}")
        length = min(int(self.headers.get("Content-Length") or 0), 65536)
        try:
            sample = json.loads(self.rfile.read(length))
        except ValueError:
            return self.reply(400, b"{}")
        if isinstance(sample, dict):
            state["sample"] = sample
            state["received"] = time.time()
        self.reply(204)


def serve():
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    server.timeout = 30
    while time.time() - max(state["received"], state["started"]) < IDLE_SECONDS:
        server.handle_request()


def get(path, timeout=1.5):
    try:
        with urllib.request.urlopen(BASE + path, timeout=timeout) as response:
            return json.loads(response.read() or b"{}")
    except (urllib.error.URLError, OSError, ValueError):
        return None


def start():
    if get("/health"):
        print("collector already running on %s" % BASE)
    else:
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(30):
            if get("/health"):
                break
            time.sleep(0.1)
        else:
            print("three-stats: the collector did not start on %s (port in use?)" % BASE, file=sys.stderr)
            return 1
        print("collector started on %s" % BASE)
    print("Attach the probe where the renderer is created, then reload the page:\n\n%s" % SNIPPET)
    return 0


def latest():
    data = get("/latest")
    if data is None:
        print("three-stats: collector not running; run `three-stats start`", file=sys.stderr)
        return 1
    if not data["live"]:
        print("three-stats: no page is reporting; attach the probe (`three-stats snippet`) and open the page in a visible tab",
              file=sys.stderr)
        return 1
    print(json.dumps(data["sample"], indent=2))
    return 0


def main(argv):
    command = argv[0] if argv else "--help"
    if command == "start":
        return start()
    if command == "latest":
        return latest()
    if command == "snippet":
        print(SNIPPET)
        return 0
    if command == "stop":
        print("stopped" if get("/stop") else "collector not running")
        return 0
    if command == "serve":
        serve()
        return 0
    print(__doc__.strip())
    return 0 if command in ("-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
